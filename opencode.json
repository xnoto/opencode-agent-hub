{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "agent-hub": {
      "type": "remote",
      "url": "http://127.0.0.1:8776/mcp",
      "enabled": true,
      "oauth": false
    },
    "context-mode": {
      "type": "local",
      "command": ["context-mode"],
      "enabled": true
    },
    "opencode-docs": {
      "type": "remote",
      "url": "http://127.0.0.1:8773/mcp",
      "enabled": true,
      "oauth": false
    },
    "tmux": {
      "type": "remote",
      "url": "http://127.0.0.1:8770/mcp",
      "enabled": true,
      "oauth": false
    },

    "linear": { "enabled": false },
    "notion": { "enabled": false },
    "aws-staging": { "enabled": false },
    "aws-prod": { "enabled": false },
    "aws-docs": { "enabled": false },
    "grafana": { "enabled": false },
    "terraform-docs": { "enabled": false },
    "opentofu-docs": { "enabled": false },
    "kubernetes": { "enabled": false },
    "argocd-staging-eks": { "enabled": false },
    "argocd-prod-eks": { "enabled": false },
    "argocd-makeitwork": { "enabled": false }
  },
  "tools": {
    "linear_*": false,
    "notion_*": false,
    "aws-staging_*": false,
    "aws-prod_*": false,
    "aws-docs_*": false,
    "grafana_*": false,
    "terraform-docs_*": false,
    "opentofu-docs_*": false,
    "kubernetes_*": false,
    "argocd-staging-eks_*": false,
    "argocd-prod-eks_*": false,
    "argocd-makeitwork_*": false
  }
}
